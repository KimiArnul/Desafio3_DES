    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSourceReporte2</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Recetas" ColumnName="NombreReceta" />
              <ColumnExpression ColumnOwner="Recetas" ColumnName="Descripcion" />
              <ColumnExpression ColumnOwner="Recetas" ColumnName="TiempoPreparacion" />
              <ColumnExpression ColumnOwner="PasosPreparacion" ColumnName="OrdenPaso" />
              <ColumnExpression ColumnOwner="PasosPreparacion" ColumnName="DescripcionPaso" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Recetas" />
              <Join Type="INNER JOIN" ColumnOwner="PasosPreparacion">
                <On>
                  <From ColumnOwner="Recetas" ColumnName="IdReceta" />
                  <To ColumnOwner="PasosPreparacion" ColumnName="RecetaId" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Recetas.NombreReceta
  ,Recetas.Descripcion
  ,Recetas.TiempoPreparacion
  ,PasosPreparacion.OrdenPaso
  ,PasosPreparacion.DescripcionPaso
FROM
  Recetas
  INNER JOIN PasosPreparacion
    ON Recetas.IdReceta = PasosPreparacion.RecetaId</CommandText>
      </Query>
      <Fields>
        <Field Name="NombreReceta">
          <rd:TypeName>System.String</rd:TypeName>
