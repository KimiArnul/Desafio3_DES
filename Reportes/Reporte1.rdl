  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_Reporte1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Recetas" ColumnName="TiempoPreparacion" />
              <ColumnExpression ColumnOwner="Recetas" ColumnName="NombreReceta" />
              <ColumnExpression ColumnOwner="Recetas" ColumnName="Descripcion" />
              <ColumnExpression ColumnOwner="Ingredientes" ColumnName="NombreIngrediente" />
              <ColumnExpression ColumnOwner="Ingredientes" ColumnName="UnidadMedida" />
              <ColumnExpression ColumnOwner="Ingredientes" ColumnName="Cantidad" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Recetas" />
              <Join Type="INNER JOIN" ColumnOwner="Ingredientes">
                <On>
                  <From ColumnOwner="Recetas" ColumnName="IdReceta" />
                  <To ColumnOwner="Ingredientes" ColumnName="RecetaId" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Recetas.TiempoPreparacion
  ,Recetas.NombreReceta
  ,Recetas.Descripcion
  ,Ingredientes.NombreIngrediente
  ,Ingredientes.UnidadMedida
  ,Ingredientes.Cantidad
FROM
  Recetas
  INNER JOIN Ingredientes
    ON Recetas.IdReceta = Ingredientes.RecetaId</CommandText>
      </Query>
      <Fields>
        <Field Name="TiempoPreparacion">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>TiempoPreparacion</DataField>
        </Field>
        <Field Name="NombreReceta">
